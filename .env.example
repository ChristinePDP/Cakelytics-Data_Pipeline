# Connection string of the CakeLytics operational (SOURCE) database
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
SOURCE_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Connection string for the SEPARATE analytics warehouse Supabase project.
# Never point this at the operational/source project.
WAREHOUSE_DB_URL=postgresql://USER:PASSWORD@WAREHOUSE_HOST:PORT/postgres

# Optional separate read-only connection for dashboard users.
WAREHOUSE_READONLY_DB_URL=postgresql://READONLY_USER:PASSWORD@WAREHOUSE_HOST:PORT/postgres
